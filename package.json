{
  "name": "node-red-contrib-plaiiinlight",
  "version": "0.1.0",
  "description": "Node-RED palette for PlaiiinLightOS lamps — config, command and state nodes over local MQTT.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "files": ["dist", "LICENSE", "README.md", "examples"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["node-red", "node-red-contrib", "plaiiinlight", "plaiiinlightos", "esp32", "led", "mqtt", "ws2812"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebeleben/plaiiin-light-nodered.git"
  },
  "homepage": "https://github.com/nebeleben/plaiiin-light-nodered#readme",
  "bugs": {
    "url": "https://github.com/nebeleben/plaiiin-light-nodered/issues"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "plaiiinlight-config": "dist/config.js",
      "plaiiinlight-command": "dist/command.js",
      "plaiiinlight-state": "dist/state.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-editor.mjs",
    "watch": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "aedes": "^0.51.0",
    "node-red": "^4.0.0",
    "node-red-node-test-helper": "^0.3.4",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
